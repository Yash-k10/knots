# ==============================================================================
# KNOTS Platform - Production Docker Compose Environment Variables
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ==============================================================================

# Database Credentials
POSTGRES_USER=knots_admin
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=knots_db
POSTGRES_PORT=5432

# Redis Service Port
REDIS_PORT=6379

# Application Security
# Generate a secure 64-char hex key: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key
ENVIRONMENT=production
PROJECT_NAME=KNOTS

# Token Expiry Settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional: Gemini API Key for AI-assisted features
GEMINI_API_KEY=
