# Project Configurations
PROJECT_NAME=KNOTS
ENVIRONMENT=development

# Database Configurations
# In local docker-compose setup, database service host is "postgres"
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/knots

# Redis Configuration
# In local docker-compose setup, redis service host is "redis"
REDIS_URL=redis://localhost:6379/0

# Security Configurations
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=super-secret-key-change-in-production-environments-jwt-token-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini Configurations
GEMINI_API_KEY=your_gemini_api_key_here

# Modern HTTP Email API Configurations (Render / Cloud-compatible via HTTPS Port 443)
# Resend (Recommended & Free tier: https://resend.com)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL="KNOTS <onboarding@resend.dev>"

# Brevo (Sendinblue - 300 free emails/day: https://brevo.com)
# BREVO_API_KEY=xkeysib-123456789

# SendGrid (Free tier: https://sendgrid.com)
# SENDGRID_API_KEY=SG.123456789

# SMTP / Email Service Configurations (Fallback for environments where SMTP ports 465/587 are open)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_college_smtp_email@sbjit.edu.in
SMTP_PASSWORD=your_app_specific_password_here
EMAILS_FROM_EMAIL=your_college_smtp_email@sbjit.edu.in
EMAILS_FROM_NAME="KNOTS Campus Hub"


